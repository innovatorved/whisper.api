---
interface Props {
  title: string;
  href: string;
  description?: string;
}

const { title, href, description } = Astro.props;
---

<a href={href} class="card-bottom-line group not-prose block rounded-xl border border-[var(--line)] bg-[var(--panel)] p-5 transition">
  <p class="m-0 flex items-center justify-between font-bold text-[var(--text)] group-hover:text-[var(--brand-ink)]">
    <span>{title}</span>
    <span class="text-[var(--brand)] transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
  </p>
  {description && <p class="m-0 mt-1.5 text-sm leading-relaxed text-[var(--muted)]">{description}</p>}
</a>
