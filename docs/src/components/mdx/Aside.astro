---
interface Props {
  type?: "tip" | "note" | "caution";
}

const { type = "note" } = Astro.props;

const config = {
  tip: {
    box: "border-[var(--ds-success-border)] bg-[var(--ds-success-bg)]",
    iconColor: "text-[var(--ds-success)]",
    label: "Tip"
  },
  note: {
    box: "border-[var(--ds-info-border)] bg-[var(--ds-info-bg)]",
    iconColor: "text-[var(--ds-info)]",
    label: "Note"
  },
  caution: {
    box: "border-[var(--ds-warning-border)] bg-[var(--ds-warning-bg)]",
    iconColor: "text-[var(--ds-warning)]",
    label: "Caution"
  }
}[type];
---

<aside class={`my-5 rounded-lg border px-4 py-3.5 text-[14px] leading-[1.6] text-[var(--ds-ink-prose)] ${config.box}`}>
  <div class={`mb-1 flex items-center gap-1.5 text-[12px] font-semibold ${config.iconColor}`}>
    {type === "tip" && (
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
        <path d="M8 2a4 4 0 0 1 2.2 7.34c-.45.3-.7.78-.7 1.32V11h-3v-.34c0-.54-.25-1.02-.7-1.32A4 4 0 0 1 8 2Z" />
        <path d="M6.5 13h3" />
      </svg>
    )}
    {type === "note" && (
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
        <circle cx="8" cy="8" r="6" />
        <path d="M8 7v4m0-6h.01" />
      </svg>
    )}
    {type === "caution" && (
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
        <path d="M8 2.2 14 13H2L8 2.2Z" />
        <path d="M8 6.5v3m0 2h.01" />
      </svg>
    )}
    <span>{config.label}</span>
  </div>
  <div class="[&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</aside>
