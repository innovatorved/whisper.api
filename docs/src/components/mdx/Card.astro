---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="card-bottom-line rounded-xl border border-[var(--line)] bg-[var(--panel)] p-5 transition">
  <h3 class="mt-0 mb-1.5 text-base font-bold text-[var(--text)]">{title}</h3>
  <div class="text-sm leading-relaxed text-[var(--muted)]">
    <slot />
  </div>
</section>
