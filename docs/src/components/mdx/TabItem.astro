---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section class="mb-4 last:mb-0">
  <p class="m-0 mb-2 inline-block rounded border border-[var(--ds-border)] bg-[var(--ds-canvas-subtle)] px-2 py-0.5 font-mono text-[11px] font-medium text-[var(--ds-ink-muted)]">
    {label}
  </p>
  <div class="[&_.ds-code-wrap]:my-0">
    <slot />
  </div>
</section>
