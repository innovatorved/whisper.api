---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section class="mb-4 last:mb-0">
  <p class="mb-2 inline-block rounded-md border border-[var(--brand-border)] bg-[var(--brand-soft)] px-2.5 py-0.5 font-mono text-xs font-semibold text-[var(--brand-ink)]">{label}</p>
  <div>
    <slot />
  </div>
</section>
